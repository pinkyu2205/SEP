      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.pinkyusteam.sep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
