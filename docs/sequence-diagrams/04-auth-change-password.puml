@startuml ChangePassword
title Figure — ChangePassword Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor User
participant "Front-end" as FE
participant "AuthController" as C
participant "AuthServiceImpl" as S
participant "SecurityUtils" as SU
participant "UserRepository" as UR
participant "PasswordEncoder" as PE
database DB

User -> FE : (1) Nhập mật khẩu cũ + mới → "Đổi mật khẩu"
FE -> C : (2) POST /api/v1/auth/change-password\nChangePasswordRequest
activate C
C -> S : (3) changePassword(request)
activate S

S -> DB : (4) BeginTransaction()
activate DB
DB --> S : (5) Success

S -> SU : (6) requireCurrentUser()
activate SU
SU --> S : (7) CustomUserDetails
deactivate SU

S -> UR : (8) findById(userId)
activate UR
UR -> DB : (9) SELECT User
DB --> UR : (10) User / empty
UR --> S : (11) User
deactivate UR

S -> PE : (12) matches(oldPassword, user.password)
activate PE
PE --> S : (13) true / false
deactivate PE

alt [Mật khẩu cũ sai]
  S --> C : BusinessException "Mật khẩu cũ không đúng"
  C --> FE : Error response
  FE --> User : Hiển thị lỗi
end

S -> PE : (14) encode(newPassword)
activate PE
PE --> S : (15) hash
deactivate PE

S -> UR : (16) save(user: password mới, firstLogin = false)
activate UR
UR -> DB : (17) UPDATE User
DB --> UR : (18) OK
UR --> S : (19) saved
deactivate UR

break [Lỗi nghiệp vụ / hệ thống]
  S -> DB : RollbackTransaction()
  DB --> S : Rolled back
  S --> C : Exception
  C --> FE : Error response
  FE --> User : Hiển thị lỗi
end

S -> DB : (20) CommitTransaction()
DB --> S : (21) Committed
deactivate DB

S --> C : (22) void
deactivate S
C --> FE : (23) 200 OK
deactivate C
FE --> User : (24) Thông báo đổi mật khẩu thành công

@enduml
